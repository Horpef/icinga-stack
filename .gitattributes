# ============================================================================
#  Finales de linea (raiz del monorepo)
# ============================================================================
#
#  Cubre los tres stacks (icinga-stack/, wazuh-stack/ y oracle-stack/) para que
#  un `git clone` futuro no los rompa. El Git de Windows de esta maquina trae
#  core.autocrlf=true a nivel de sistema y convierte LF -> CRLF al hacer
#  checkout; eso mata los .sh (dash los rechaza con `\r: command not found`) y
#  puede romper un Dockerfile (una linea RUN con CRLF acaba en `sh: not found`).
#
#  Los .ps1 se declaran CRLF: los ejecuta PowerShell 5.1 en Windows y traga los
#  dos formatos, pero es lo habitual. El indice guarda LF en todos los casos.
#
#  icinga-stack/.gitattributes repite estas reglas para su subarbol (manda el
#  mas especifico, y coinciden). Este fichero existe ademas para cubrir
#  wazuh-stack/ y oracle-stack/, que no tenian ninguno.

*.sh           text eol=lf
*.conf         text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.sql          text eol=lf
*.md           text eol=lf
*.py           text eol=lf
*.txt          text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Sin extension, asi que autocrlf no lo detecta como texto y lo pasaria a CRLF
# sin mas. En un Dockerfile las lineas RUN se ejecutan con /bin/sh.
Dockerfile     text eol=lf
*.dockerfile   text eol=lf

*.ps1          text eol=crlf
